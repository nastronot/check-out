[Unit]
Description=check-out VFD daemon (sole serial-port owner)
Documentation=https://github.com/check-out
# NO ordering relative to the other checkout-* units (or default.target): the
# services are order-independent by design (socket + state.json self-coordination).
# A prior After=default.target was part of a boot-time ordering cycle — see the
# note in checkout-audioviz.service.

[Service]
Type=simple
WorkingDirectory=__CHECKOUT_REPO__
ExecStart=__CHECKOUT_REPO__/.venv/bin/python -m checkout.daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
