[Unit]
Description=check-out web control surface (FastAPI + Svelte UI)
Documentation=https://github.com/check-out
# NO ordering relative to the other checkout-* units (or default.target): the
# services are order-independent by design (the web app only reads status.json and
# writes state.json — never the port). See checkout-audioviz.service for why the
# prior ordering was removed (a boot-time cycle).

[Service]
Type=simple
WorkingDirectory=__CHECKOUT_REPO__
ExecStart=__CHECKOUT_REPO__/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
